# Sao chép file này thành .env (cùng thư mục backend) rồi điền khóa API.
# KHÔNG gửi file .env cho người khác.

# Hãng AI đọc ảnh phiếu: deepseek | gemini | qwen | openai | anthropic
OCR_PROVIDER=deepseek
# Để trống = dùng mô hình mặc định của hãng (deepseek-flash = DeepSeek V4.1 Flash)
OCR_MODEL=

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database (mặc định: ../data/sale.db)
# SALE_DB_URL=sqlite:///D:/SaleManager/data/sale.db
# SALE_DB_URL=sqlite:////opt/sale-manager/data/sale.db                  (Linux)
# SALE_DB_URL=postgresql+psycopg://sale:matkhau@127.0.0.1:5432/sale     (PostgreSQL – cài thêm requirements-postgres.txt)

# Người dùng & vai trò mặc định khi KHÔNG bật đăng nhập (máy nội bộ)
SALE_USER=admin
# ADMIN | MANAGER | CHIEF_ACCOUNTANT | ACCOUNTANT | STAFF
SALE_DEFAULT_ROLE=ADMIN

# ĐĂNG NHẬP – BẮT BUỘC khi chạy trên VPS / Internet.
# Mỗi người: tên:mật_khẩu_đã_băm:VAI_TRÒ, cách nhau dấu phẩy. Tạo mật khẩu băm:  python -m app.auth hash
# SALE_AUTH_USERS=hien:pbkdf2~...:CHIEF_ACCOUNTANT,lan:pbkdf2~...:STAFF
